CONFIG_IDF_TARGET="esp32s3"

# CPU Frequency
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# C is built for size, not for debugging.
#
# The Rust half of this image has been `-Os`/`-Oz` since the beginning; the C half — ESP-IDF, LVGL,
# mbedtls, the board HAL — was still on ESP-IDF's `-Og` default, which is a debugging level. A
# release build has no debugger attached to it. With this on, the image that the wasm runtime pushed
# past the end of an `ota_0` slot fits again; nothing here was optimised for speed to begin with
# (see `[profile.release]` in `components/rust_main/Cargo.toml` for the other half of the argument).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Flash 16MB QIO
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Octal PSRAM 8MB
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Direct all normal heap allocations (including Rust data structures) to 8MB/16MB PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# Strictly reserve 32KB of internal SRAM for critical DMA buffers, FreeRTOS stacks & semaphores
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# Custom Partition Table (5 MB LittleFS storage)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Application rollback: an over-the-air update that does not come up goes back.
#
# The two app slots are `ota_0` and `ota_1` with nothing behind them (see `partitions.csv`), so a
# newly written image is the only thing to boot and a bad one has nowhere to fall back to — unless
# this is on. With it on, `esp_ota_set_boot_partition` leaves the new image in the "pending verify"
# state, the bootloader boots it, and only the image's own word makes that stick: the app calls
# `board_hal_confirm_boot()` once it has proved it came up (the first frame reaching the panel, see
# `board_display.c`). Without that word — a panic before the first frame, a board init that does not
# finish — the next reset finds the image still pending and boots the *previous* one instead.
#
# A USB flash is not this case: with an empty `otadata` the bootloader marks the image valid itself,
# so the board that is flashed over the cable never waits on anything.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# The task viewer's whole reading: `uxTaskGetSystemState` is behind this, and without it
# there is no per-task name, state, priority or stack high-water mark to list. It costs a
# few bytes per task rather than any run time.
#
# `CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID` is deliberately *not* set beside it. The core
# a task runs on is worth a column, but that config is gated behind the stats-formatting
# functions — a `vTaskList` this image never calls — and `xTaskGetCoreID`, which the C side
# asks instead, gives the same answer for nothing.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Run time stats: how much of the counter each task has used, which is the only thing on
# this board that can tell a working core from an idle one.
#
# The trace facility above fills in every column of the task list except this one: without
# these stats `uxTaskGetSystemState` leaves each task's `ulRunTimeCounter` at zero, and a
# list that can say *where* a task runs but never *how much* cannot answer the question
# this board's second core raises — whether anything is on it. `IDLE0` and `IDLE1` are the
# two rows that answer it: the idle task is what a core runs when nothing else will, so
# its share of the total *is* that core's spare time, and neither core's count is
# visible in any other reading here.
#
# The price is a counter read on every context switch, and this image switches tasks a
# few thousand times a second. That is the trade: a measurement knob worth having on
# while something is being looked at, and the first thing to turn back off when the cost
# of a context switch is itself what is being looked at.
#
# The counter's clock source and width are deliberately left at IDF's defaults. Nothing
# downstream depends on either: the C side takes both from the field FreeRTOS fills in,
# and every share is computed against the total that came out of the same read, so a
# different clock in a later IDF changes the numbers and not the arithmetic.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Console over USB-Serial-JTAG for Waveshare AMOLED board
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Main task stack size (Rust runtime benefits from adequate stack: 64KB)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536

# The core the application runs on.
#
# `app_main` never returns: it becomes the iced event loop, and the whole Rust side — the
# compositor, the rasteriser, the panel handoff — lives inside it for the life of the image.
# IDF's default for that task is CPU0, which is also where the Wi-Fi and TCP/IP tasks live, so
# a frame and a packet end up queued for the same core and a network burst lands in the middle
# of a repaint. Measured on this board the other core is otherwise idle — IDLE1 sits at 99.9%
# of it — and that is the headroom this claims: the radio keeps CPU0, the panel gets CPU1.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# Completely disable Brownout Detector to prevent battery voltage ripple reset loops
# CONFIG_ESP_BROWNOUT_DET is not set

# Wi-Fi station support (used by board_wifi.c and the Wi-Fi HAL).
# NOTE: Wi-Fi buffers are allocated from internal RAM; if boot-time allocation
# fails on hardware, revisit CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL and the
# CONFIG_ESP_WIFI_*_BUFFER_NUM options.
CONFIG_ESP_WIFI_ENABLED=y

# mbedTLS allocates from PSRAM.
#
# Internal SRAM is what Wi-Fi buffers, DMA descriptors and every task stack come out of, and
# a single TLS session asks for a 16 KB receive buffer in one contiguous block on top of the
# context and the record layer. The internal pool is down to a few tens of kilobytes once the
# GUI and the radio are up, so that block is not there to be had and `mbedtls_ssl_setup`
# returns MBEDTLS_ERR_SSL_ALLOC_FAILED — every HTTPS page on this board failed to connect
# because of it. The 8 MB of PSRAM have room to spare, and IDF's AES/PSA layers fall back to
# their non-DMA paths for buffers that live there.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Cross-signed roots are real roots.
#
# Alibaba's `*.aliyuncs.com` chain ends in `GlobalSign Root R46` *as signed by* `GlobalSign Root CA`
# — a cross-signed copy of a root that is already in the bundle — and mbedTLS without this option
# refuses to anchor there. Every single `ecs.<region>.aliyuncs.com` handshake came back
# "No matching trusted root certificate found", which looked like a wrong region list and was a
# verification flag. Tencent's chain ends in a plain root and never needed it.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
